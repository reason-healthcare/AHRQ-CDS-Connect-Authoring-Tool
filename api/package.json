    "@babel/register": "^7.28.3",
    "@eslint/js": "^9.35.0",
    "@types/archiver": "^7.0.0",
    "@types/basic-auth": "^1.1.4",
    "@types/busboy": "^1.5.4",
    "@types/chai": "^5.2.3",
    "@types/convict": "^6.1.6",
    "@types/express": "^4.17.21",
    "@types/fhir": "^0.0.41",
    "@types/lodash": "^4.17.7",
    "@types/mocha": "^10.0.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.12",
    "@types/passport": "^1.0.16",
    "@types/passport-local": "^1.0.38",
    "@types/sinon": "^21.0.0",
    "@types/slug": "^5.0.7",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@types/validator": "^13.11.7",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "babel-plugin-rewire": "^1.2.0",
    "chai": "^6.0.1",
    "chai-exclude": "^3.0.1",
    "eslint": "^9.35.0",
    "esmock": "^2.7.2",
    "globals": "^16.4.0",
    "mocha": "^11.7.2",
    "nock": "^14.0.10",
    "nodemon": "^3.1.10",
    "nyc": "^17.1.0",
    "opener": "^1.5.2",
    "prettier": "^3.6.2",
    "sinon": "^21.0.0",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "type-check": "tsc --noEmit",
    "lint:fix": "eslint --fix .; exit 0",
    "lint": "eslint .",
    "prettier": "prettier --check \"**/*.+(js|jsx|json|css|md|ts|tsx)\"",
    "prettier:fix": "prettier --write \"**/*.+(js|jsx|json|css|md|ts|tsx)\"",
    "start-dev": "nodemon",
    "start": "node dist/server.js",
    "start:ts": "ts-node --esm src/server.ts",
    "dev:ts": "nodemon --exec \"node --loader ts-node/esm src/server.js\"",
    "test-ci": "mocha --reporter spec --recursive --no-colors",
    "test-cov": "nyc --reporter=html --reporter=text --report-dir=./.nyc_output/coverage mocha --reporter spec --recursive",
    "test": "NODE_OPTIONS=\"--experimental-vm-modules --loader ts-node/esm --no-warnings\" TS_NODE_PROJECT=./tsconfig.json TS_NODE_ESM=true mocha --reporter spec --recursive \"test/**/*.test.{js,ts}\"",
    "open-cov": "opener ./.nyc_output/coverage/index.html"
  },
  "prettier": {
    "trailingComma": "none",
    "singleQuote": true,
    "printWidth": 120,
    "arrowParens": "avoid"
  },
  "babel": {
    "presets": [
      "@babel/preset-typescript"
    ],
    "plugins": []
  }
}
